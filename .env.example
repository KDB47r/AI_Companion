# App
APP_NAME=AI Companion
DEV_TOKEN=dev-token

# Database
DATABASE_URL=postgresql+asyncpg://postgres:ai_companion@127.0.0.1:5432/ai_companion
DB_ECHO=false
MAX_HISTORY_MESSAGES=20
DEV_USER_EXTERNAL_ID=dev-user

# LLM provider: fake | openai_compat
LLM_PROVIDER=fake

# OpenAI-compatible provider (DeepSeek example)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_INCLUDE_USAGE=true

# Qwen / DashScope OpenAI-compatible mode:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# P0 fake provider
FAKE_RESPONSE=你好呀，我是小火。今天想聊点什么？
FAKE_DELAY_SECONDS=0.02

# SSE
SSE_HEARTBEAT_SECONDS=15
